#!/usr/bin/env bash
# ns-canada — Canadian public-records searches. Opens targeted searches and the
# relevant registries in the browser, copies the query to the clipboard for
# registries that can't be deep-linked, and logs every search to the case.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

PY="$NS_HOME/venvs/core/bin/python"
g() { ns_google "$1"; }

# Record, copy to clipboard and tell the user what happened
finish() {   # finish <kind> <query>
  local out
  out=$(ns_outdir canada "$2")
  printf '%s\t%s\n' "$1" "$2" > "$out/query.txt"
  ns_audit "ns-canada:$1" "$2" "searches opened in browser"
  ui_clip "$2"
  ui_info "Searches are open in your browser.

\"$2\" is on your clipboard - paste it (Ctrl/Cmd+V) into any registry page that opened without a search."
}

choice=$(ui_list "Canada search" \
  "Person" \
  "Business / organization" \
  "Phone number" \
  "Address / postal code" \
  "Financial & regulatory check" \
  "Political contributions & lobbying" \
  "Vessel" \
  "Aircraft" \
  "Vehicle (VIN)" \
  "Amateur radio call sign") || exit 0

case "$choice" in

Person)
  q=$(ui_entry "Full name:") || exit 0
  n="\"$q\""
  ui_open \
    "$(g "$n site:canlii.org")" \
    "$(g "$n (site:legacy.com OR site:inmemoriam.ca OR site:dignitymemorial.com) Canada")" \
    "$(g "$n site:ca.linkedin.com")" \
    "$(g "$n (site:cbc.ca OR site:ctvnews.ca OR site:globalnews.ca OR site:thestar.com OR site:theglobeandmail.com)")" \
    "$(g "$n site:gazette.gc.ca")" \
    "$(g "$n (site:ontario.ca OR site:canada.ca OR site:gc.ca)")" \
    "https://www.canada411.ca/" \
    "https://geds-sage.gc.ca/"
  finish person "$q" ;;

"Business / organization")
  q=$(ui_entry "Business or organization name:") || exit 0
  ui_open \
    "https://opencorporates.com/companies?q=$(ns_enc "$q")" \
    "https://ised-isde.canada.ca/cc/lgcy/fdrlCrpSrch.html" \
    "https://www.ontario.ca/page/ontario-business-registry" \
    "https://www.sedarplus.ca/" \
    "https://apps.cra-arc.gc.ca/ebci/hacc/srch/pub/dsplyAdvncdSrch" \
    "https://fintrac-canafe.canada.ca/msb-esm/reg-eng" \
    "$(g "\"$q\" site:canlii.org")" \
    "$(g "\"$q\" (scam OR fraud OR complaint OR lawsuit) Canada")"
  finish business "$q" ;;

"Phone number")
  q=$(ui_entry "Phone number (any format):") || exit 0
  d=$(printf '%s' "$q" | tr -dc '0-9')
  [ ${#d} -eq 11 ] && [ "${d:0:1}" = "1" ] && d="${d:1}"
  if [ ${#d} -ne 10 ]; then ui_error "Enter a 10-digit North American number."; exit 1; fi
  a=${d:0:3}; x=${d:3:3}; s=${d:6:4}
  f1="$a-$x-$s"; f2="($a) $x-$s"; f3="$a.$x.$s"
  info=""
  if [ -x "$PY" ]; then
    info=$("$PY" - "$d" <<'PY' 2>/dev/null
import sys, phonenumbers
from phonenumbers import geocoder, carrier, PhoneNumberType
n = phonenumbers.parse("+1" + sys.argv[1])
types = {v: k for k, v in vars(PhoneNumberType).items() if isinstance(v, int)}
print("Valid:", phonenumbers.is_valid_number(n))
print("Region:", geocoder.description_for_number(n, "en") or "unknown")
print("Country:", phonenumbers.region_code_for_number(n) or "unknown")
print("Original carrier:", carrier.name_for_number(n, "en") or "unknown (porting not tracked)")
print("Type:", types.get(phonenumbers.number_type(n), "unknown"))
PY
)
  fi
  ui_open \
    "$(g "\"$f1\" OR \"$f2\" OR \"$f3\" OR \"$d\"")" \
    "$(g "\"$f1\" OR \"$d\" (scam OR fraud OR spam)")" \
    "$(g "\"$f1\" OR \"$f2\" (site:facebook.com OR site:kijiji.ca OR site:linkedin.com)")" \
    "https://www.canada411.ca/" \
    "https://www.cnac.ca/"
  out=$(ns_outdir canada "$f1")
  printf '%s\n\n%s\n' "$f1" "$info" > "$out/phone.txt"
  ns_audit "ns-canada:phone" "$f1" "searches opened in browser"
  ui_clip "$f1"
  ui_info "$f1

${info:-Phone analysis unavailable - run ./install.sh --only canada}

Searches are open in your browser. The number is on your clipboard for Canada411's reverse lookup." ;;

"Address / postal code")
  q=$(ui_entry "Address or postal code:") || exit 0
  ui_open \
    "https://www.google.com/maps/search/?api=1&query=$(ns_enc "$q")" \
    "https://www.openstreetmap.org/search?query=$(ns_enc "$q")" \
    "$(g "\"$q\"")" \
    "https://www.onland.ca/" \
    "https://www.aboutmyproperty.ca/" \
    "https://www.canadapost-postescanada.ca/info/mc/personal/postalcode/fpc.jsf"
  finish address "$q" ;;

"Financial & regulatory check")
  q=$(ui_entry "Person or firm name:") || exit 0
  ui_open \
    "https://www.aretheyregistered.ca/" \
    "https://fintrac-canafe.canada.ca/msb-esm/reg-eng" \
    "https://fintrac-canafe.canada.ca/msb-esm/revoked-revoquee-eng" \
    "https://www.ic.gc.ca/app/scr/bsf-osb/ins/login.html?lang=eng" \
    "https://www.international.gc.ca/world-monde/international_relations-relations_internationales/sanctions/consolidated-consolide.aspx?lang=eng" \
    "$(g "\"$q\" (site:osc.ca OR site:bcsc.bc.ca OR site:securities-administrators.ca OR site:albertasecurities.com OR site:lautorite.qc.ca)")" \
    "$(g "\"$q\" site:canlii.org")"
  finish financial "$q" ;;

"Political contributions & lobbying")
  q=$(ui_entry "Person or organization name:") || exit 0
  ui_open \
    "https://www.elections.ca/WPAPPS/WPF/EN/CCS/Index" \
    "https://www.elections.on.ca/en/political-financing0.html" \
    "https://contributions.electionsbc.gov.bc.ca/pcs/SA1ASearch.aspx" \
    "https://lobbycanada.gc.ca/" \
    "$(g "\"$q\" site:lobbycanada.gc.ca")"
  finish political "$q" ;;

Vessel)
  q=$(ui_entry "Vessel name or official number:") || exit 0
  ui_open "https://eve.tc.canada.ca/en/VR-IB/search" \
          "https://recherche-collection-search.bac-lac.gc.ca/eng/home/searchadvanced?SubsetCode=253&DataSource=Archives%7CFonAndCol" \
          "$(g "\"$q\" vessel Canada")"
  finish vessel "$q" ;;

Aircraft)
  q=$(ui_entry "Registration (e.g. C-GABC):") || exit 0
  q=$(ns_upper "$q")
  ui_open "https://wwwapps.tc.gc.ca/saf-sec-sur/2/ccarcs-riacc/RchSimp.aspx" \
          "$(g "\"$q\" aircraft")"
  finish aircraft "$q" ;;

"Vehicle (VIN)")
  q=$(ui_entry "17-character VIN:") || exit 0
  q=$(ns_upper "$(printf '%s' "$q" | tr -dc 'A-Za-z0-9')")
  ui_open "https://vpic.nhtsa.dot.gov/decoder/Decoder?VIN=$q" "$(g "\"$q\"")"
  finish vin "$q" ;;

"Amateur radio call sign")
  q=$(ui_entry "Call sign:") || exit 0
  q=$(ns_upper "$(printf '%s' "$q" | tr -dc 'A-Za-z0-9/')")
  ui_open "https://www.qrz.com/db/$q" \
          "https://ised-isde.canada.ca/site/amateur-radio-operator-certificate-services/en" \
          "$(g "\"$q\"")"
  finish callsign "$q" ;;
esac
