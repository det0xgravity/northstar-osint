#!/usr/bin/env bash
# northstar — main menu for all northstar-osint tools.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

export NS_FROM_MAIN=1

while true; do
  case_name=$(ns_case)
  choice=$(ui_list "Active case: $case_name" \
    "Missing person (profile, timeline, findings)" \
    "Username & email" \
    "Telegram" \
    "Domain & infrastructure" \
    "Media download" \
    "Capture web pages" \
    "Metadata" \
    "Image analysis" \
    "Video verification" \
    "Photo geolocation" \
    "Face comparison (within this case)" \
    "Page monitoring (proof of life)" \
    "Case map" \
    "Translate (offline)" \
    "Country search" \
    "Breach data" \
    "Dark web" \
    "Evidence & exhibits" \
    "API keys" \
    "Notes (Obsidian)" \
    "Case: notes, details, report, close" \
    "Switch / create case  (current: $case_name)" \
    "Open latest results" \
    "Open case folder" \
    "Health check" \
    "Update northstar") || break

  case "$choice" in
    "Missing person"*)         ns-missing ;;
    "Username & email")        ns-username ;;
    "Telegram")                ns-telegram ;;
    "Domain & infrastructure") ns-domain ;;
    "Media download")          ns-media ;;
    "Capture web pages")       ns-archive ;;
    "Metadata")                ns-metadata ;;
    "Image analysis")          ns-image ;;
    "Video verification")      ns-video ;;
    "Photo geolocation")       ns-geo ;;
    "Face comparison"*)        ns-face ;;
    "Page monitoring"*)        ns-watch ;;
    "Case map")                ns-map ;;
    "Translate"*)              ns-translate ;;
    "Country search")          ns-country ;;
    "Breach data")             ns-breach ;;
    "Dark web")                ns-darkweb ;;
    "Evidence & exhibits")     ns-evidence ;;
    "API keys")                ns-keys ;;
    "Notes (Obsidian)")        ns-notes ;;
    "Case:"*)                  ns-case ;;
    "Switch / create case"*)   ns-case open ;;
    "Open latest results")
      last=$(cat "$NS_CONF/last_result" 2>/dev/null)
      if [ -n "$last" ] && [ -d "$last" ]; then ui_reveal "$last"; else ui_reveal "$(ns_case_dir)"; fi ;;
    "Open case folder")        ui_reveal "$(ns_case_dir)" ;;
    "Health check")            ns-doctor ;;
    "Update northstar")        ns-update ;;
  esac
done
