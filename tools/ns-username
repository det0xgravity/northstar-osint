#!/usr/bin/env bash
# ns-username — account discovery by username or email address.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

choice=$(ui_list "Username & email" \
  "Username search (sherlock, maigret, socialscan, blackbird)" \
  "Email search (holehe, socialscan)" \
  "Google account from email (GHunt — run 'ghunt login' once first)" \
  "Instagram profile details (toutatis — needs a session ID)" \
  "Generate username and email variants from a name") || exit 0

case "$choice" in
Username*)
  u=$(ui_entry "Username (without @):") || exit 0
  u="${u#@}"
  out=$(ns_outdir username "$u")
  ns_run "$out" sherlock "$u" --print-found --txt --output "$out/sherlock.txt"
  ns_run "$out" maigret "$u" --html --folderoutput "$out/maigret"
  ns_run "$out" socialscan "$u"
  # Blackbird always saves into its own install folder; move this run's files
  bb="$NS_HOME/src/blackbird/results"; mark="$out/.blackbird-start"; touch "$mark"
  ns_run "$out" blackbird --username "$u" --csv --json
  if [ -d "$bb" ]; then
    mkdir -p "$out/blackbird"
    find "$bb" -mindepth 1 -maxdepth 1 -newer "$mark" -exec mv {} "$out/blackbird/" \;
  fi
  rm -f "$mark"
  ui_clip "$u"
  ui_open "https://whatsmyname.app/" "$(ns_google "\"$u\"")"
  echo "Username copied to clipboard for WhatsMyName."
  ui_notify "\"$u\" is on your clipboard: paste it into WhatsMyName"
  ns_finish "$out" ;;

Email*)
  e=$(ui_entry "Email address:") || exit 0
  out=$(ns_outdir email "$e")
  ns_run "$out" holehe "$e" --only-used
  ns_run "$out" socialscan "$e"
  ui_clip "$e"
  ui_open "https://haveibeenpwned.com/" "https://epieos.com/" "https://intelx.io/" \
          "$(ns_google "\"$e\"")"
  echo "Email copied to clipboard for the breach/lookup sites."
  ui_notify "\"$e\" is on your clipboard: paste it into the breach and lookup sites"
  ns_finish "$out" ;;

Google*)
  e=$(ui_entry "Gmail / Google account email:") || exit 0
  out=$(ns_outdir ghunt "$e")
  ns_run "$out" ghunt email "$e" --json "$out/ghunt.json"
  ns_finish "$out" ;;

Generate*)
  sub="$(ns_case_dir)/subject"
  pre_name=""; pre_year=""
  if ns_cmd ns_missing && [ -f "$sub/subject.json" ]; then
    pre_name=$(ns_missing profile-get "$(ns_case_dir)" name)
    pre_year=$(ns_missing profile-get "$(ns_case_dir)" dob | grep -oE '(19|20)[0-9]{2}' | head -1)
  fi
  name=$(ui_entry "Full name:" "$pre_name") || exit 0
  year=$(ui_entry "Birth year (optional):" "$pre_year") || year=""
  out=$(ns_outdir variants "$name")
  ns_missing variants "$name" "$year" > "$out/variants.tsv"
  grep '^username' "$out/variants.tsv" | cut -f2 > "$out/usernames.txt"
  grep '^email' "$out/variants.tsv" | cut -f2 > "$out/emails.txt"
  ns_audit variants "$name" "$(wc -l < "$out/usernames.txt" | tr -d ' ') usernames, $(wc -l < "$out/emails.txt" | tr -d ' ') emails"
  echo "Likely usernames:"; sed 's/^/  /' "$out/usernames.txt" | head -12
  if ui_question "Check the 10 most likely usernames with Sherlock? (a few minutes)"; then
    # shellcheck disable=SC2046  # one argument per username, on purpose
    ns_run "$out" sherlock $(head -10 "$out/usernames.txt") --print-found --txt --folderoutput sherlock
  fi
  if ui_question "Check the 10 most likely emails with holehe (which sites they're registered on)?"; then
    while IFS= read -r e; do ns_run "$out" holehe "$e" --only-used; done <<EMAILS
$(head -10 "$out/emails.txt")
EMAILS
  fi
  ns_finish "$out" ;;

Instagram*)
  u=$(ui_entry "Instagram username:") || exit 0
  sid=$(ui_secret "Instagram sessionid cookie from a sock-puppet login (input is hidden):") || exit 0
  out=$(ns_outdir instagram "$u")
  if ns_cmd toutatis; then
    # Run directly (not via ns_run) so the session cookie never reaches the audit
    # log. toutatis only takes it as an argument, so other processes on this
    # machine could see it in `ps` while it runs: use a throwaway puppet account.
    ns_audit toutatis "$u" "toutatis -u $u -s <redacted>"
    ( cd "$out" && toutatis -u "$u" -s "$sid" ) 2>&1 | tee -a "$out/console.log"
  else
    echo "  [skip] toutatis is not installed"
  fi
  ns_finish "$out" ;;
esac
