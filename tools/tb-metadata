#!/usr/bin/env bash
# tb-metadata — view, export and remove metadata from documents, images and media.
# Originals are never modified: cleaned copies go to the case folder.
# shellcheck source=../lib/ui.sh
. "${TB_HOME:-$HOME/.local/share/truebearing}/lib/ui.sh"

choice=$(ui_list "Metadata" \
  "View metadata of one or more files" \
  "Export metadata for a whole folder to CSV" \
  "Make clean copies with metadata removed" \
  "Make a scanned PDF searchable (OCR)") || exit 0

case "$choice" in
"Make a scanned PDF"*)
  tb_cmd ocrmypdf || { ui_error "OCRmyPDF isn't installed: ./install.sh --only media"; exit 1; }
  f=$(ui_files "Choose a PDF") || exit 0
  f=$(printf '%s\n' "$f" | head -1)
  [ -f "$f" ] || exit 0
  base=$(basename "$f" .pdf)
  out=$(tb_outdir ocr "$base")
  cp -p "$f" "$out/$base.original.pdf"
  # The original is kept; the searchable copy and a plain-text version sit beside it
  tb_run "$out" ocrmypdf --skip-text --sidecar "$base.txt" -- "$base.original.pdf" "$base.searchable.pdf"
  tb_finish "$out"
  exit 0 ;;
View*)
  files=$(ui_files "Choose file(s) to inspect") || exit 0
  out=$(tb_outdir metadata "inspect")
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    printf '\n\033[1m=== %s ===\033[0m\n' "$base"
    tb_audit exiftool "$base" "exiftool -a -G1 -s"
    exiftool -a -G1 -s "$f" | tee "$out/$base.exif.txt"
    if tb_cmd mediainfo && file -b --mime-type "$f" | grep -qE '^(video|audio)/'; then
      mediainfo "$f" > "$out/$base.mediainfo.txt"
      echo "  (mediainfo report saved)"
    fi
    gps=$(exiftool -n -p '$GPSLatitude,$GPSLongitude' "$f" 2>/dev/null)
    if [ -n "$gps" ]; then
      echo "  GPS: $gps"
      echo "$gps" > "$out/$base.gps.txt"
      ui_open "https://www.google.com/maps/search/?api=1&query=$gps"
    fi
  done <<EOF
$files
EOF
  tb_finish "$out" ;;

Export*)
  dir=$(ui_dir "Choose a folder") || exit 0
  out=$(tb_outdir metadata "$(basename "$dir")")
  tb_audit exiftool "$(basename "$dir")" "exiftool -r -csv -n $dir"
  exiftool -r -csv -n "$dir" > "$out/metadata.csv" 2> "$out/console.log"
  echo "  $(($(wc -l < "$out/metadata.csv") - 1)) files exported to metadata.csv"
  tb_finish "$out" ;;

"Make clean"*)
  files=$(ui_files "Choose file(s) to clean") || exit 0
  out=$(tb_outdir metadata "cleaned")
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    cp "$f" "$out/$base"
    if tb_cmd mat2 && mat2 --inplace "$out/$base" >/dev/null 2>&1; then
      echo "  cleaned (mat2): $base"
    else
      exiftool -q -all= -overwrite_original "$out/$base" && echo "  cleaned (exiftool): $base"
    fi
    tb_audit metadata-clean "$base" "copy cleaned to $out"
  done <<EOF
$files
EOF
  tb_finish "$out" ;;
esac
