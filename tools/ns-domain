#!/usr/bin/env bash
# ns-domain — domain, DNS and web infrastructure reconnaissance.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

choice=$(ui_list "Domain & infrastructure" \
  "Full subdomain recon (subfinder > dnsx > httpx > gowitness)" \
  "WHOIS, RDAP & DNS records" \
  "Emails & hosts (theHarvester)" \
  "Passive enumeration (amass)" \
  "Crawl a site (katana)" \
  "Archived URLs (waymore)" \
  "Lookalike / typosquat domains (dnstwist)" \
  "Screenshot a list of URLs (gowitness)") || exit 0

if [ "${choice#Screenshot}" = "$choice" ]; then
  d=$(ui_entry "Domain (e.g. example.com):") || exit 0
  d=$(ns_lower "$d" | sed -E 's#^[a-z]+://##; s#/.*$##; s#^www\.##')
  [ -n "$d" ] || exit 0
  # A hostname only: anything else could be read as a command-line option
  if ! printf '%s' "$d" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'; then
    ui_error "\"$d\" isn't a valid domain name."; exit 1
  fi
fi

case "$choice" in
"Full subdomain recon"*)
  out=$(ns_outdir domain "$d")
  ns_run "$out" subfinder -d "$d" -all -silent -o subdomains.txt
  [ -s "$out/subdomains.txt" ] || echo "$d" > "$out/subdomains.txt"
  echo "  $(wc -l < "$out/subdomains.txt" | tr -d ' ') subdomains"
  ns_run "$out" dnsx -l subdomains.txt -silent -a -resp -o resolved.txt
  ns_run "$out" httpx -l subdomains.txt -silent -title -status-code -tech-detect \
                      -follow-redirects -o live.txt
  if [ -s "$out/live.txt" ]; then
    cut -d' ' -f1 "$out/live.txt" > "$out/live_urls.txt"
    echo "  $(wc -l < "$out/live_urls.txt" | tr -d ' ') live web hosts"
    ns_run "$out" gowitness scan file -f live_urls.txt -s screenshots --write-jsonl
  fi
  ns_finish "$out" ;;

"WHOIS, RDAP & DNS"*)
  out=$(ns_outdir domain "$d")
  ns_run "$out" whois "$d" > /dev/null
  cp "$out/console.log" "$out/whois.txt" 2>/dev/null
  # RDAP replaced WHOIS for generic TLDs in 2025; it's structured and often fuller
  if curl -fsSL --max-time 30 "https://rdap.org/domain/$d" -o "$out/rdap.json" 2>/dev/null; then
    ns_audit rdap "$d" "https://rdap.org/domain/$d"
    jq -r '"Registrar: " + ([.entities[]? | select(.roles | index("registrar")) | .vcardArray[1][]? | select(.[0]=="fn") | .[3]] | first // "?"),
           (.events[]? | "\(.eventAction): \(.eventDate)"),
           "Nameservers: " + ([.nameservers[]?.ldhName] | join(", ")),
           "Status: " + ((.status // []) | join(", "))' "$out/rdap.json" 2>/dev/null | tee "$out/rdap.txt"
  else
    rm -f "$out/rdap.json"; echo "  RDAP: no record found for $d"
  fi
  for t in A AAAA MX NS TXT SOA CAA; do
    printf '%-5s ' "$t"; dig +short "$t" "$d" | tr '\n' ' '; echo
  done | tee "$out/dns.txt"
  ns_audit dig "$d" "dig +short A AAAA MX NS TXT SOA CAA $d"
  ui_open "https://crt.sh/?q=$(ns_enc "%.$d")" "https://urlscan.io/search/#$(ns_enc "domain:$d")" \
          "https://viewdns.info/reverseip/?host=$(ns_enc "$d")&t=1" \
          "https://client.rdap.org/?type=domain&object=$(ns_enc "$d")"
  ns_finish "$out" ;;

"Emails & hosts"*)
  out=$(ns_outdir domain "$d")
  ns_run "$out" theHarvester -d "$d" -b all -f theharvester
  ns_finish "$out" ;;

"Passive enumeration"*)
  out=$(ns_outdir domain "$d")
  # Amass v5 is passive by default and stores findings in its engine's own
  # database (it ignores -dir for that); 'amass subs' exports the names.
  ns_run "$out" amass enum -d "$d" -nocolor
  ns_run "$out" amass subs -names -nocolor -d "$d" -o amass.txt
  ns_finish "$out" ;;

"Crawl a site"*)
  out=$(ns_outdir crawl "$d")
  ns_run "$out" katana -u "https://$d" -d 3 -jc -silent -o crawl.txt
  ns_finish "$out" ;;

"Archived URLs"*)
  out=$(ns_outdir archive "$d")
  ns_run "$out" waymore -i "$d" -mode U -oU archived_urls.txt
  ns_finish "$out" ;;

"Lookalike"*)
  out=$(ns_outdir lookalike "$d")
  ns_run "$out" dnstwist --registered --format csv --output lookalikes.csv "$d"
  ns_finish "$out" ;;

"Screenshot"*)
  f=$(ui_files "Text file with one URL per line") || exit 0
  f=$(printf '%s\n' "$f" | head -1)
  [ -f "$f" ] || exit 0
  out=$(ns_outdir screenshots "$(basename "$f")")
  cp "$f" "$out/urls.txt"
  ns_run "$out" gowitness scan file -f urls.txt -s screenshots --write-jsonl
  ns_finish "$out" ;;
esac
