#!/usr/bin/env bash
# ns-notes — working notes in Obsidian. ~/Northstar/Cases is one vault: each
# case has a Case.md overview and a Results.md log of its result folders, and
# notes about people, accounts, organisations, places, events and leads are
# made from templates. The tamper-evident record stays in notes.md and audit.log.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

case_dir=$(ns_case_dir)
ns_vault case "$case_dir" >/dev/null

have_obsidian() {
  ns_cmd obsidian && return 0
  if ui_mac; then [ -d "${NS_OBSIDIAN_APP:-/Applications/Obsidian.app}" ]
  else flatpak info md.obsidian.Obsidian >/dev/null 2>&1; fi
}

# Without Obsidian: offer to install it (the notes module), else open the note
# in the default text editor so the work isn't lost
open_note() {
  local repo
  if ! have_obsidian; then
    repo=$(cat "$NS_CONF/repo_path" 2>/dev/null)
    if [ -x "$repo/install.sh" ] && ui_question "Obsidian isn't installed yet.

Install it now? It runs the notes module in this terminal (it may ask for your password), then opens the note."; then
      "$repo/install.sh" --only notes --yes
    fi
    if ! have_obsidian; then
      ns_audit ns-notes "$(basename "$1")" "opened in the default editor (Obsidian not installed)"
      ui_info "Obsidian isn't available, so the note opens in your text editor:
$1

Install Obsidian later with: $repo/install.sh --only notes"
      ui_reveal "$1"
      return
    fi
  fi
  ns_audit ns-notes "$(basename "$1")" "opened in Obsidian"
  ui_reveal "$(ns_vault uri "$1")"
}

choice=$(ui_list "Notes (Obsidian): case $(ns_case)" \
  "Open this case's notes" \
  "New finding from the latest result" \
  "New note: finding" \
  "Discount a finding" \
  "New note: person" \
  "New note: account" \
  "New note: organisation" \
  "New note: place" \
  "New note: event" \
  "New note: lead" \
  "Open the Cases vault (all cases)" \
  "Refresh this case's notes (rebuild result notes)" \
  "Add a contemporaneous note (tamper-evident)") || exit 0

closed() {
  [ "$(ns_casework status "$case_dir")" = closed ] || return 1
  ui_error "Case $(ns_case) is closed. Reopen it first (Case → Reopen this case)."
}

case "$choice" in
  "Open this case"*)
    open_note "$case_dir/Case.md" ;;
  "New finding from the latest result")
    last=$(cat "$NS_CONF/last_result" 2>/dev/null)
    [ -n "$last" ] && [ -d "$last" ] || { ui_error "No recent result in this case: run a search first, or use New note: finding."; exit 0; }
    rn=$(ns_vault result "$case_dir" "$last" | tail -1)
    title=$(ui_entry "Finding (a short statement, e.g. \"Subject posted from Kingston on 2 Oct\"):") || exit 0
    [ -n "$title" ] || exit 0
    p=$(ns_vault new "$case_dir" finding "$title") || { ui_error "Couldn't create the finding."; exit 1; }
    link=$(printf '%s' "${rn#"$NS_DATA/Cases/"}" | sed 's/\.md$//')
    exid=$(python3 -c 'import csv, sys
try: rows = list(csv.DictReader(open(sys.argv[1], encoding="utf-8", newline="")))
except OSError: rows = []
print(([r["exhibit_id"] for r in rows if r.get("folder", "").rstrip("/") == sys.argv[2]] or [""])[-1])' "$case_dir/exhibits.csv" "${last#"$case_dir/"}")
    python3 - "$p" "[[$link]]" "$exid" <<'PYEOF2'
import json, re, sys
path, link = sys.argv[1], sys.argv[2]
t = open(path, encoding="utf-8").read()
t = re.sub(r"(?m)^results: \[\]$", "results:\n  - " + json.dumps(link), t, count=1)
if len(sys.argv) > 3 and sys.argv[3]:          # the result is a recorded exhibit
    t = re.sub(r"(?m)^exhibits: \[\]$", "exhibits:\n  - " + json.dumps(sys.argv[3]), t, count=1)
open(path, "w", encoding="utf-8").write(t)
PYEOF2
    ns_audit ns-notes "finding" "finding created from $(basename "$last")"
    open_note "$p" ;;
  "Discount a finding")
    closed && exit 1
    items=()
    for f in "$case_dir"/Findings/*.md; do
      [ -f "$f" ] || continue
      grep -q '^status: discounted' "$f" || items+=("$(basename "$f" .md)")
    done
    [ ${#items[@]} -gt 0 ] || { ui_info "No findings to discount."; exit 0; }
    pick=$(ui_list "Discount which finding? (it stays on record as unused material)" "${items[@]}") || exit 0
    why=$(ui_entry "Why is it discounted? (recorded in the contemporaneous notes)") || exit 0
    [ -n "$why" ] || exit 0
    ns_vault discount "$case_dir" "$pick" "$why" >/dev/null || { ui_error "Couldn't discount it."; exit 1; }
    ns_casework note "$case_dir" "[DISCOUNTED] Finding '$pick': $why" >/dev/null \
      || ui_error "The finding is discounted, but the note recording it couldn't be saved: add it with Add a contemporaneous note." 
    ns_audit ns-notes "discount" "$pick"
    ui_notify "Finding discounted: $pick" ;;
  "New note: "*)
    kind=${choice#New note: }
    title=$(ui_entry "Title for the $kind note (for example a name or username):") || exit 0
    [ -n "$title" ] || exit 0
    p=$(ns_vault new "$case_dir" "$kind" "$title") || { ui_error "Couldn't create the note."; exit 1; }
    ns_audit ns-notes "$kind" "note created: $(basename "$p")"
    open_note "$p" ;;
  "Refresh"*)
    r=$(ns_vault refresh "$case_dir"); ns_audit ns-notes "refresh" "$r"
    ui_notify "$r"
    open_note "$case_dir/Case.md" ;;
  "Open the Cases vault"*)
    ns_vault setup "$NS_DATA" >/dev/null
    open_note "$NS_DATA/Cases/Home.md" ;;
  "Add a contemporaneous"*)
    closed && exit 1
    t=$(ui_entry "Note (saved with the UTC time; it can't be edited later without it showing):") || exit 0
    ns_casework note "$case_dir" "$t" >/dev/null || { ui_error "The note couldn't be saved."; exit 1; }
    ns_audit ns-case "note" "note added"
    ui_notify "Note saved to case $(ns_case)" ;;
esac
