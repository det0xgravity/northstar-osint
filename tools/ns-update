#!/usr/bin/env bash
# ns-update — pull the latest northstar-osint and upgrade every installed tool.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/northstar"
repo=$(cat "$CONF/repo_path" 2>/dev/null)

if [ -z "$repo" ] || [ ! -x "$repo/install.sh" ]; then
  echo "Can't find the northstar-osint checkout (expected path in $CONF/repo_path)."
  echo "Clone it again and run ./install.sh from there."
  exit 1
fi

pulled=1
if [ -d "$repo/.git" ]; then
  echo "Updating northstar-osint in $repo…"
  if ! git -C "$repo" pull --ff-only; then
    pulled=0
    printf '\n\033[1;31m[!] Could not download the new northstar version.\033[0m\n'
    echo "    Usually this means files in $repo were edited by hand:"
    git -C "$repo" status --short | sed 's/^/      /'
    echo "    Put your own bookmarks and extensions in ~/.config/northstar/ instead"
    echo "    (see docs/INSTALL.md), then discard the edits and update again:"
    echo "      git -C \"$repo\" stash && ns-update"
    echo "    Upgrading the installed tools with the current version for now."
    echo
  fi
fi

"$repo/install.sh" --update --yes "$@"
status=$?
if [ $pulled = 0 ]; then
  printf '\n\033[1;31m[!] northstar itself was NOT updated — see the message at the top.\033[0m\n'
  status=1
fi
if [ "${NS_FROM_MAIN:-0}" != 1 ] && [ -t 0 ]; then
  printf '\nPress Enter to close… '; read -r _
fi
exit $status
