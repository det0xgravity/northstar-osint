#!/usr/bin/env bash
# ns-evidence — exhibits and integrity checks for the active case: seal a result
# folder as a numbered exhibit (optionally with an OpenTimestamps proof), verify
# folders and the audit log's hash chain, and export the case with a checksum.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

case_dir=$(ns_case_dir)
last=$(cat "$NS_CONF/last_result" 2>/dev/null)

pick_folder() {
  local f
  if [ -n "$last" ] && [ -d "$last" ] && ui_question "Use the latest results?

$last"; then
    printf '%s\n' "$last"; return 0
  fi
  f=$(ui_dir "Choose a result folder in $case_dir") || return 1
  printf '%s\n' "${f%/}"
}

choice=$(ui_list "Evidence: case $(ns_case)" \
  "Record a result folder as an exhibit" \
  "Verify a folder (has anything changed?)" \
  "Verify the audit log's hash chain" \
  "List exhibits" \
  "Export the case (archive + SHA-256)" \
  "Export the case, encrypted (age or PGP)" \
  "Check received or suspicious files (triage)") || exit 0

case "$choice" in
  Record*)
    f=$(pick_folder) || exit 0
    [ -f "$f/manifest.sha256" ] || ns_seal_result "$f"
    ns_evidence verify "$f" >/dev/null || { ui_error "Files in this folder changed after it was sealed. Run \"Verify a folder\" for details."; exit 1; }
    desc=$(ui_entry "Short description of this exhibit:") || exit 0
    if ns_cmd ots && ui_question "Add an independent OpenTimestamps proof? (sends only the manifest's hash to public timestamp servers)"; then
      ( cd "$f" && ots stamp manifest.sha256 ) && ns_audit ots "$(basename "$f")" "OpenTimestamps proof requested"
    fi
    r=$(ns_evidence exhibit "$case_dir" "$f" "$desc" 2>&1)
    ns_audit ns-evidence "$(basename "$f")" "exhibit: $(printf '%s' "$r" | head -1)"
    ns_cmd ns_vault && ns_vault result "$case_dir" "$f" >/dev/null     # the result note shows its exhibit ID
    printf '%s\n' "$r"; ui_info "$r" ;;
  "Verify a folder"*)
    f=$(pick_folder) || exit 0
    r=$(ns_evidence verify "$f" 2>&1)
    ns_audit ns-evidence "$(basename "$f")" "verify: $(printf '%s' "$r" | sed -n 2p)"
    printf '%s\n' "$r"; ui_info "$r" ;;
  "Verify the audit"*)
    r=$(ns_evidence audit-verify "$case_dir/audit.log" 2>&1)
    printf '%s\n' "$r"; ui_info "$r" ;;
  List*)
    if [ -s "$case_dir/exhibits.csv" ]; then
      r=$(cut -d, -f1-4 "$case_dir/exhibits.csv" | column -t -s, 2>/dev/null || cat "$case_dir/exhibits.csv")
    else r="No exhibits recorded yet in case $(ns_case)."; fi
    printf '%s\n' "$r"; ui_info "$r" ;;
  "Check received"*)
    files=$(ui_files "Choose the files to check (nothing is opened or run)") || exit 0
    set --
    while IFS= read -r f; do [ -e "$f" ] && set -- "$@" "$f"; done <<FILES
$files
FILES
    [ $# -gt 0 ] || exit 0
    out=$(ns_outdir triage "$(basename "$1")")
    ns_run "$out" ns_triage --json "$out/triage.json" "$@"
    cp "$out/console.log" "$out/triage.txt" 2>/dev/null
    v=$(sed -n 's/^File triage: //p' "$out/triage.txt" | head -1)
    ns_audit ns-evidence "triage" "$v"
    ui_info "File triage: $v

Nothing was opened or run. The full report is in the case (triage.txt). No warning signs is not proof that a file is safe: open documents only in this VM."
    ns_finish "$out" ;;
  "Export the case, encrypted"*)
    how=$(ui_list "Encrypt the export for" \
      "A passphrase (you type it in the terminal; share it by another channel)" \
      "The recipient's public key (age1… or an ssh-ed25519 / ssh-rsa key)" \
      "The recipient's PGP public key (a .asc or .gpg key file)") || exit 0
    key="" fpr=""
    case "$how" in
      *PGP*)
        ns_cmd gpg || { ui_error "GnuPG isn't installed: ./install.sh --only core"; exit 1; }
        kf=$(ui_files "Choose the recipient's PGP public key file") || exit 0
        kf=$(printf '%s\n' "$kf" | head -1)
        [ -f "$kf" ] || exit 0
        # A throwaway keyring: the recipient's key never joins your own
        gh=$(mktemp -d "${TMPDIR:-/tmp}/ns-gpg.XXXXXX"); chmod 700 "$gh"
        trap 'gpgconf --homedir "$gh" --kill all >/dev/null 2>&1; rm -rf "$gh"' EXIT
        gpg --homedir "$gh" --batch --quiet --import "$kf" >/dev/null 2>&1
        cols=$(gpg --homedir "$gh" --batch --with-colons --fingerprint 2>/dev/null)
        n=$(printf '%s\n' "$cols" | grep -c '^pub:')
        if [ "$n" -ne 1 ]; then
          ui_error "That file holds $n public keys. Use a file with only the recipient's key (a private key or an unreadable file shows as 0)."; exit 1
        fi
        pub=$(printf '%s\n' "$cols" | grep '^pub:' | head -1)
        fpr=$(printf '%s\n' "$cols" | awk -F: '/^fpr:/ {print $10; exit}')
        uid=$(printf '%s\n' "$cols" | awk -F: '/^uid:/ {print $10; exit}')
        case "$(printf '%s' "$pub" | cut -d: -f2)" in
          r) ui_error "That key has been revoked by its owner. Ask the recipient for their current key."; exit 1 ;;
          e) ui_error "That key has expired. Ask the recipient for their current key."; exit 1 ;;
        esac
        case "$(printf '%s' "$pub" | cut -d: -f12)" in
          *E*) ;;
          *) ui_error "That key can't be used for encryption (it has no usable encryption subkey)."; exit 1 ;;
        esac
        spaced=$(printf '%s' "$fpr" | sed 's/..../& /g; s/ $//')
        ui_question "Encrypt the export for this key?

${uid:-(no user ID)}
Fingerprint: $spaced

Check the fingerprint with the recipient by phone or in person, not by the channel the key came from." || exit 0
        ;;
      "The recipient"*)
        ns_cmd age || { ui_error "age isn't installed: ./install.sh --only core"; exit 1; }
        key=$(ui_entry "Recipient's public key (age1… or ssh-ed25519 …):") || exit 0
        case "$key" in age1*|ssh-ed25519\ *|ssh-rsa\ *) ;; *) ui_error "That isn't an age or SSH public key."; exit 1 ;; esac
        ;;
      *)
        ns_cmd age || { ui_error "age isn't installed: ./install.sh --only core"; exit 1; } ;;
    esac
    r=$(ns_evidence export "$case_dir" "$NS_DATA/Exports" 2>&1) || { ui_error "$r"; exit 1; }
    plain=$(printf '%s\n' "$r" | sed -n 's/^Exported: //p')
    if [ -n "$fpr" ]; then
      enc="$plain.gpg"
      # The archive is already compressed
      gpg --homedir "$gh" --batch --yes --quiet --trust-model always --compress-algo none \
          --recipient "$fpr" --output "$enc" --encrypt "$plain" 2>/dev/null
    elif [ -n "$key" ]; then
      enc="$plain.age"
      age -r "$key" -o "$enc" "$plain"
    else
      enc="$plain.age"
      printf '\nChoose a passphrase for %s (age asks twice; nothing is shown as you type).\n' "$(basename "$enc")"
      age -p -o "$enc" "$plain"
    fi
    if [ ! -s "$enc" ]; then
      rm -f "$enc"; ui_error "Encryption didn't complete. The unencrypted archive is still in $NS_DATA/Exports."; exit 1
    fi
    chmod 600 "$enc"
    sha=$(ns_hash_file "$enc")
    printf '%s  %s\n' "$sha" "$(basename "$enc")" > "$enc.sha256"
    # The encrypted copy replaces the plain one; the plain archive's hash stays in its .sha256
    rm -f "$plain"
    if [ -n "$fpr" ]; then
      for_whom="PGP key $fpr"; tip="Only the holder of that PGP key can open it."
      dcmd="gpg --output $(basename "$plain") --decrypt $(basename "$enc")"
    elif [ -n "$key" ]; then
      for_whom="recipient key $(printf '%s' "$key" | cut -c1-24)…"; tip="Only the holder of the matching private key can open it."
      dcmd="age -d -i <their key file> -o $(basename "$plain") $(basename "$enc")"
    else
      for_whom="passphrase"; tip="Share the passphrase by a different channel from the file."
      dcmd="age -d -o $(basename "$plain") $(basename "$enc")"
    fi
    ns_audit ns-evidence "$(ns_case)" "encrypted export: $(basename "$enc") sha256 $sha ($for_whom)"
    r="Encrypted export: $enc
SHA-256: $sha

The archive inside is the same as an ordinary export (its own SHA-256 is in $(basename "$plain").sha256). The recipient decrypts it with:
  $dcmd
$tip"
    printf '%s\n' "$r"; ui_info "$r"; ui_reveal "$NS_DATA/Exports" ;;
  Export*)
    r=$(ns_evidence export "$case_dir" "$NS_DATA/Exports" 2>&1)
    ns_audit ns-evidence "$(ns_case)" "export: $(printf '%s' "$r" | tail -1)"
    printf '%s\n' "$r"; ui_info "$r"; ui_reveal "$NS_DATA/Exports" ;;
esac
