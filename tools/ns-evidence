#!/usr/bin/env bash
# ns-evidence — exhibits and integrity checks for the active case: seal a result
# folder as a numbered exhibit (optionally with an OpenTimestamps proof), verify
# folders and the audit log's hash chain, and export the case with a checksum.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

case_dir=$(ns_case_dir)
last=$(cat "$NS_CONF/last_result" 2>/dev/null)

pick_folder() {
  local f
  if [ -n "$last" ] && [ -d "$last" ] && ui_question "Use the latest results?

$last"; then
    printf '%s\n' "$last"; return 0
  fi
  f=$(ui_dir "Choose a result folder in $case_dir") || return 1
  printf '%s\n' "${f%/}"
}

choice=$(ui_list "Evidence: case $(ns_case)" \
  "Record a result folder as an exhibit" \
  "Verify a folder (has anything changed?)" \
  "Verify the audit log's hash chain" \
  "List exhibits" \
  "Export the case (archive + SHA-256)") || exit 0

case "$choice" in
  Record*)
    f=$(pick_folder) || exit 0
    [ -f "$f/manifest.sha256" ] || ns_seal_result "$f"
    ns_evidence verify "$f" >/dev/null || { ui_error "Files in this folder changed after it was sealed. Run \"Verify a folder\" for details."; exit 1; }
    desc=$(ui_entry "Short description of this exhibit:") || exit 0
    if ns_cmd ots && ui_question "Add an independent OpenTimestamps proof? (sends only the manifest's hash to public timestamp servers)"; then
      ( cd "$f" && ots stamp manifest.sha256 ) && ns_audit ots "$(basename "$f")" "OpenTimestamps proof requested"
    fi
    r=$(ns_evidence exhibit "$case_dir" "$f" "$desc" 2>&1)
    ns_audit ns-evidence "$(basename "$f")" "exhibit: $(printf '%s' "$r" | head -1)"
    printf '%s\n' "$r"; ui_info "$r" ;;
  "Verify a folder"*)
    f=$(pick_folder) || exit 0
    r=$(ns_evidence verify "$f" 2>&1)
    ns_audit ns-evidence "$(basename "$f")" "verify: $(printf '%s' "$r" | sed -n 2p)"
    printf '%s\n' "$r"; ui_info "$r" ;;
  "Verify the audit"*)
    r=$(ns_evidence audit-verify "$case_dir/audit.log" 2>&1)
    printf '%s\n' "$r"; ui_info "$r" ;;
  List*)
    if [ -s "$case_dir/exhibits.csv" ]; then
      r=$(cut -d, -f1-4 "$case_dir/exhibits.csv" | column -t -s, 2>/dev/null || cat "$case_dir/exhibits.csv")
    else r="No exhibits recorded yet in case $(ns_case)."; fi
    printf '%s\n' "$r"; ui_info "$r" ;;
  Export*)
    r=$(ns_evidence export "$case_dir" "$NS_DATA/Exports" 2>&1)
    ns_audit ns-evidence "$(ns_case)" "export: $(printf '%s' "$r" | tail -1)"
    printf '%s\n' "$r"; ui_info "$r"; ui_reveal "$NS_DATA/Exports" ;;
esac
