#!/usr/bin/env bash
# ns-telegram — Telegram research. Without a login: look up a channel, group,
# bot or user and search a public channel's web preview. With a research
# account: search Telegram for public chats and users, search messages, list a
# group's visible members, read a user's profile, and collect channels (posts,
# metadata, forward networks) with telegram-tracker. Results land in the case.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

need_tracker() {
  ns_cmd tgtracker && return 0
  ui_error "telegram-tracker isn't installed. Run: ./install.sh --only social"
  exit 1
}

# channel name from "name", "@name", "t.me/name" or "https://t.me/s/name/123"
channel_name() {
  printf '%s' "$1" | sed -E 's#^https?://##; s#^(t\.me|telegram\.me)/(s/)?##; s#^@##; s#[/?].*$##' | tr -cd 'A-Za-z0-9_'
}

need_engine() {
  ns_cmd ns_telegram && return 0
  ui_error "The Telegram engine isn't installed. Run: ./install.sh --only social"
  exit 1
}

# api <kind> <slug> <ns_telegram args...>: run an engine command into a result folder
api() {
  local kind="$1" slug="$2" out; shift 2
  out=$(ns_outdir telegram "$kind-$slug")
  ns_run "$out" ns_telegram "$@"
  ns_finish "$out"
}

# collect <outdir> <tgtracker collect args...>
collect() {
  local out="$1"; shift
  ns_run "$out" tgtracker collect "$@" -o data
  ns_run "$out" tgtracker build-dataset --data-path data
  ns_run "$out" tgtracker build-network --data-path data
}

choice=$(ui_list "Telegram" \
  "Look up a channel, group, bot or user (no login)" \
  "Search a public channel's posts (no login)" \
  "Search for channels (TGStat and web search)" \
  "Search Telegram for public chats and users (login)" \
  "Search messages in a channel or group (login)" \
  "Members of a group (login)" \
  "User profile (login)" \
  "Collect a public channel" \
  "Collect a list of channels (text file, one per line)" \
  "Log in for searches (needed once)" \
  "Log in for channel collection (needed once)") || exit 0

case "$choice" in
  "Look up"*)
    need_engine
    c=$(channel_name "$(ui_entry "Username or t.me link:")") || exit 0
    [ -n "$c" ] || { ui_error "That isn't a Telegram username."; exit 1; }
    api lookup "$c" lookup "$c" ;;

  "Search a public channel"*)
    need_engine
    c=$(channel_name "$(ui_entry "Channel username or t.me link:")") || exit 0
    [ -n "$c" ] || { ui_error "That isn't a Telegram channel name."; exit 1; }
    q=$(ui_entry "Search words (empty for the latest posts):") || q=""
    api preview "$c" preview-search "$c" "$q" ;;

  "Search Telegram"*)
    need_engine
    q=$(ui_entry "Search words or a name:") || exit 0
    [ -n "$q" ] || exit 0
    api search "$q" search "$q" ;;

  "Search messages"*)
    need_engine
    c=$(ui_entry "Channel or group username, t.me link, or numeric ID:") || exit 0
    q=$(ui_entry "Search words (empty for the latest messages):") || q=""
    n=$(ui_entry "How many messages at most:" "500") || exit 0
    case "$n" in ''|*[!0-9]*) n=500 ;; esac
    api messages "$(channel_name "$c")" messages "$c" "$q" "$n" ;;

  "Members of a group"*)
    need_engine
    c=$(channel_name "$(ui_entry "Group username or t.me link:")") || exit 0
    [ -n "$c" ] || exit 0
    api members "$c" members "$c" ;;

  "User profile"*)
    need_engine
    c=$(channel_name "$(ui_entry "Username or t.me link:")") || exit 0
    [ -n "$c" ] || exit 0
    api user "$c" user "$c" ;;

  "Log in for searches"*)
    need_engine
    if [ -z "$(ns_key_get TELEGRAM_API_ID)" ] || [ -z "$(ns_key_get TELEGRAM_API_HASH)" ]; then
      ui_info "First add the research account's API ID and API hash: main menu → API keys.

Get them at https://my.telegram.org/apps: log in with the research account's phone number and create an app."
      ui_open "https://my.telegram.org/apps"
      exit 0
    fi
    # Interactive and outside ns_run: the phone number, code and password are
    # typed into Telethon directly and never reach audit.log
    ns_audit ns_telegram "login" "Telegram login for searches (credentials not recorded)"
    ns_telegram login
    ns_pause ;;

  "Collect a public channel")
    need_tracker
    c=$(channel_name "$(ui_entry "Channel username or t.me link:")") || exit 0
    [ -n "$c" ] || { ui_error "That isn't a Telegram channel name."; exit 1; }
    since=$(ui_entry "Only posts since (YYYY-MM-DD), or 'all':" "all") || exit 0
    out=$(ns_outdir telegram "$c")
    printf 'https://t.me/%s\n' "$c" > "$out/source_url.txt"
    case "$since" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) collect "$out" --telegram-channel "$c" --since "$since" ;;
                     *) collect "$out" --telegram-channel "$c" ;; esac
    ui_open "https://t.me/s/$c" "https://tgstat.com/channel/@$c"
    ns_finish "$out" ;;

  "Collect a list"*)
    need_tracker
    f=$(ui_files "Text file with one channel per line") || exit 0
    f=$(printf '%s\n' "$f" | head -1)
    [ -f "$f" ] || exit 0
    out=$(ns_outdir telegram "$(basename "$f")")
    while IFS= read -r line || [ -n "$line" ]; do
      line=$(channel_name "$line"); [ -n "$line" ] && printf '%s\n' "$line"
    done < "$f" > "$out/channels.txt"
    [ -s "$out/channels.txt" ] || { ui_error "No channel names found in that file."; exit 1; }
    collect "$out" --batch-file channels.txt
    ns_finish "$out" ;;

  "Search for channels"*)
    q=$(ui_entry "Search words:") || exit 0
    ns_audit telegram-search "$q" "TGStat and web search opened"
    ui_clip "$q"
    ui_open "https://tgstat.com/" \
            "$(ns_google "\"$q\" (site:t.me OR site:telegram.me)")" \
            "$(ns_google "\"$q\" site:tgstat.com")"
    ui_notify "\"$q\" is on your clipboard: paste it into TGStat's search" ;;

  "Log in for channel"*)
    need_tracker
    ui_info "Telegram login runs in this terminal window.

You'll need an API ID and API hash from https://my.telegram.org/apps (log in there with the research account's phone number, then create an app), then the phone number and the code Telegram sends.

Use a research account, not your personal one." || true
    ui_open "https://my.telegram.org/apps"
    # Interactive and outside ns_run: the hash and login code are typed into
    # telegram-tracker directly and never reach audit.log
    ns_audit tgtracker "login" "Telegram login (credentials not recorded)"
    tgtracker auth login
    ns_pause ;;
esac
