#!/usr/bin/env bash
# ns-map — every coordinate in the case on one map: places you record (last
# seen, sightings, home, work), GPS from photo EXIF, and GeoCLIP estimates from
# Photo geolocation. Writes GeoJSON and KML for QGIS or Google Earth, and an
# interactive map.html.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

case_dir=$(ns_case_dir)

choice=$(ui_list "Case map: case $(ns_case)" \
  "Build the case map" \
  "Add a place (address or coordinates)" \
  "List recorded places" \
  "Open the latest case map in QGIS") || exit 0

case "$choice" in
  "Build"*)
    out=$(ns_outdir map "case-map")
    ns_run "$out" ns_casemap build "$case_dir" .
    ns_seal_result "$out" >/dev/null
    if [ -s "$out/map.html" ] && ui_question "Open the map in the browser? It loads map tiles from CARTO and OpenStreetMap, which see the areas you view. case.kml and case.geojson open offline in Google Earth or QGIS."; then
      ui_reveal "$out/map.html"
    fi
    ns_finish "$out" ;;

  "Open the latest case map in QGIS")
    g=$(ls -t "$case_dir"/map/*/case.geojson 2>/dev/null | head -1)
    [ -n "$g" ] || { ui_error "No case map yet: use Build the case map first."; exit 1; }
    ns_audit ns-map "qgis" "opened $(basename "$(dirname "$g")")/case.geojson in QGIS"
    ui_info "QGIS opens the case map's points (case.geojson) with no background map, so nothing is fetched.

To add one: Layer → Add Layer → Add XYZ Layer (OpenStreetMap). The tile server then sees the areas you view.

Save any QGIS project outside the sealed map folder, for example in the case's own folder."
    if ui_mac && [ -d /Applications/QGIS.app ]; then open -a QGIS "$g"
    elif ns_cmd flatpak && flatpak info org.qgis.qgis >/dev/null 2>&1; then ( setsid flatpak run org.qgis.qgis "$g" >/dev/null 2>&1 & )
    else ui_error "QGIS isn't installed: ./install.sh --only gis"; exit 1; fi ;;
  "Add a place"*)
    kind=$(ui_list "What kind of place?" "last seen" "sighting" "home" "work or school" "vehicle" "other") || exit 0
    pre=""
    [ "$kind" = "last seen" ] && ns_cmd ns_missing && pre=$(ns_missing profile-get "$case_dir" last_seen_place 2>/dev/null)
    where=$(ui_entry "Address or place, or coordinates as lat, lon (e.g. 45.4215, -75.6972):" "$pre") || exit 0
    if printf '%s' "$where" | grep -Eq '^[[:space:]]*-?[0-9]+(\.[0-9]+)?[[:space:]]*,[[:space:]]*-?[0-9]+(\.[0-9]+)?[[:space:]]*$'; then
      lat=$(printf '%s' "$where" | cut -d, -f1 | tr -d ' '); lon=$(printf '%s' "$where" | cut -d, -f2 | tr -d ' ')
      label=$(ui_entry "Label:" "$kind") || exit 0
    else
      ns_audit ns-map "$where" "address lookup (OpenStreetMap Nominatim)"
      if ! hit=$(ns_casemap geocode "$where" 2>&1); then ui_error "$hit"; exit 0; fi
      lat=$(printf '%s' "$hit" | cut -f1); lon=$(printf '%s' "$hit" | cut -f2)
      ui_question "Found: $(printf '%s' "$hit" | cut -f3)
($lat, $lon)

Use this?" || exit 0
      label=$(ui_entry "Label:" "$where") || exit 0
    fi
    when=""
    if [ "$kind" = "last seen" ] && ns_cmd ns_missing; then when=$(ns_missing profile-get "$case_dir" last_seen 2>/dev/null); fi
    when=$(ui_entry "When (UTC, YYYY-MM-DD HH:MM), optional:" "$when") || when=""
    r=$(ns_casemap add "$case_dir" "$kind" "$lat" "$lon" "$label" "$when")
    printf '%s\n' "$r"; ui_notify "$r" ;;

  "List"*)
    r=$(ns_casemap list "$case_dir"); printf '%s\n' "$r"; ui_info "$r" ;;
esac
