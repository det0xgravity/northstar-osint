#!/usr/bin/env bash
# ns-metadata — view, export and remove metadata from documents, images and media.
# Originals are never modified: cleaned copies go to the case folder.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

choice=$(ui_list "Metadata" \
  "View metadata of one or more files" \
  "Export metadata for a whole folder to CSV" \
  "Make clean copies with metadata removed") || exit 0

case "$choice" in
View*)
  files=$(ui_files "Choose file(s) to inspect") || exit 0
  out=$(ns_outdir metadata "inspect")
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    printf '\n\033[1m=== %s ===\033[0m\n' "$base"
    ns_audit exiftool "$base" "exiftool -a -G1 -s"
    exiftool -a -G1 -s "$f" | tee "$out/$base.exif.txt"
    if ns_cmd mediainfo && file -b --mime-type "$f" | grep -qE '^(video|audio)/'; then
      mediainfo "$f" > "$out/$base.mediainfo.txt"
      echo "  (mediainfo report saved)"
    fi
    gps=$(exiftool -n -p '$GPSLatitude,$GPSLongitude' "$f" 2>/dev/null)
    if [ -n "$gps" ]; then
      echo "  GPS: $gps"
      echo "$gps" > "$out/$base.gps.txt"
      ui_open "https://www.google.com/maps/search/?api=1&query=$gps"
    fi
  done <<EOF
$files
EOF
  ns_finish "$out" ;;

Export*)
  dir=$(ui_dir "Choose a folder") || exit 0
  out=$(ns_outdir metadata "$(basename "$dir")")
  ns_audit exiftool "$(basename "$dir")" "exiftool -r -csv -n $dir"
  exiftool -r -csv -n "$dir" > "$out/metadata.csv" 2> "$out/console.log"
  echo "  $(($(wc -l < "$out/metadata.csv") - 1)) files exported to metadata.csv"
  ns_finish "$out" ;;

"Make clean"*)
  files=$(ui_files "Choose file(s) to clean") || exit 0
  out=$(ns_outdir metadata "cleaned")
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    cp "$f" "$out/$base"
    if ns_cmd mat2 && mat2 --inplace "$out/$base" >/dev/null 2>&1; then
      echo "  cleaned (mat2): $base"
    else
      exiftool -q -all= -overwrite_original "$out/$base" && echo "  cleaned (exiftool): $base"
    fi
    ns_audit metadata-clean "$base" "copy cleaned to $out"
  done <<EOF
$files
EOF
  ns_finish "$out" ;;
esac
