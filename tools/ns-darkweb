#!/usr/bin/env bash
# ns-darkweb — dark web lookups through Tor: check the Tor connection, search
# the Ahmia onion index, save an onion page as text only, check ransomware
# leak-site claims, and open Tor Browser.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

if [ ! -f "$NS_CONF/darkweb_notice" ]; then
  ui_question "Before you use the dark web tools:

- Only investigate where you have a lawful basis and authorisation.
- Pages are fetched as TEXT ONLY through Tor: no images, scripts or downloads. Never download files from onion sites.
- If you come across child sexual abuse material, stop and report it to the police or your national hotline. Do not save, screenshot or share it.
- Work inside this VM, and never sign in to personal accounts over Tor.

Continue?" || exit 0
  mkdir -p "$NS_CONF" && date > "$NS_CONF/darkweb_notice"
fi

# Make sure the Tor SOCKS proxy is up, offering to start it
tor_ready() {
  ns_darkweb check >/dev/null 2>&1 && return 0
  if ui_mac; then
    ns_cmd brew && ns_cmd tor || { ui_error "Tor isn't installed. Run: ./install.sh --only darkweb"; return 1; }
    ui_question "Tor isn't running. Start it now (brew services start tor)?" || return 1
    brew services start tor >/dev/null 2>&1
  else
    ns_cmd tor || { ui_error "Tor isn't installed. Run: ./install.sh --only darkweb"; return 1; }
    ui_question "Tor isn't running. Start it now? (asks for your sudo password in the terminal)" || return 1
    sudo systemctl start tor
  fi
  echo "Waiting for Tor to connect…"
  local i=0
  while [ $i -lt 12 ]; do
    sleep 5
    ns_darkweb check >/dev/null 2>&1 && return 0
    i=$((i+1))
  done
  ui_error "Tor didn't connect within a minute. Check: systemctl status tor (Linux) or brew services list (macOS)."
  return 1
}

open_tor_browser() {
  if ui_mac; then
    open -a "Tor Browser" 2>/dev/null || ui_error "Tor Browser isn't installed. Run: ./install.sh --only browsers"
  elif [ -x "$NS_HOME/tor-browser/Browser/start-tor-browser" ]; then
    _ui_detach "$NS_HOME/tor-browser/Browser/start-tor-browser" --detach
  elif ns_cmd flatpak && flatpak info org.torproject.torbrowser-launcher >/dev/null 2>&1; then
    _ui_detach flatpak run org.torproject.torbrowser-launcher
  else
    ui_error "Tor Browser isn't installed. Run: ./install.sh --only browsers"
  fi
}

choice=$(ui_list "Dark web" \
  "Check Tor connection" \
  "Search onion services (Ahmia)" \
  "Fetch an onion page as text (safe)" \
  "Ransomware leak-site check (organisation)" \
  "Open Tor Browser") || exit 0

case "$choice" in
  Check*)
    if tor_ready; then r=$(ns_darkweb check 2>&1); else r="Tor is not available."; fi
    printf '%s\n' "$r"
    ui_info "$r" ;;

  Search*)
    # Ahmia's search form uses an anti-bot token, so northstar doesn't automate
    # it: the search opens in your browser with the query on the clipboard.
    q=$(ui_entry "Search terms:") || exit 0
    ns_audit ns-darkweb:ahmia "$q" "opened Ahmia (clearnet index of onion sites)"
    ui_clip "$q"
    ui_info "Click OK to open Ahmia, a search engine for onion sites. \"$q\" is on your clipboard: paste it into the search box.

Ahmia removes abuse material from its index. Open results in Tor Browser, or save one as text with \"Fetch an onion page as text\"."
    ui_open "https://ahmia.fi/"
    ui_notify "\"$q\" is on your clipboard: paste it into Ahmia" ;;

  Fetch*)
    u=$(ui_entry "Onion address or URL:") || exit 0
    tor_ready || exit 1
    host=$(printf '%s' "$u" | sed -E 's#^[a-z]+://##; s#/.*$##' | cut -c1-24)
    out=$(ns_outdir darkweb "$host")
    ns_run "$out" ns_darkweb fetch "$u"
    ns_finish "$out" ;;

  Ransomware*)
    q=$(ui_entry "Organisation name or domain:") || exit 0
    out=$(ns_outdir ransomware "$q")
    ns_run "$out" ns_darkweb ransomware "$q"
    ns_finish "$out" ;;

  Open*)
    open_tor_browser ;;
esac
