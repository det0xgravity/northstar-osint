#!/usr/bin/env bash
# ns-darkweb — dark web lookups through Tor: check the Tor connection, search
# the Ahmia onion index, save an onion page as text only, check ransomware
# leak-site claims, open Tor Browser, and send or receive files over private
# OnionShare links.
# shellcheck source=../lib/ui.sh
. "${NS_HOME:-$HOME/.local/share/northstar}/lib/ui.sh"

if [ ! -f "$NS_CONF/darkweb_notice" ]; then
  ui_question "Before you use the dark web tools:

- Only investigate where you have a lawful basis and authorisation.
- Pages are fetched as TEXT ONLY through Tor: no images, scripts or downloads. Never download files from onion sites.
- If you come across child sexual abuse material, stop and report it to the police or your national hotline. Do not save, screenshot or share it.
- Work inside this VM, and never sign in to personal accounts over Tor.

Continue?" || exit 0
  mkdir -p "$NS_CONF" && date > "$NS_CONF/darkweb_notice"
fi

# Make sure the Tor SOCKS proxy is up, offering to start it
tor_ready() {
  ns_darkweb check >/dev/null 2>&1 && return 0
  if ui_mac; then
    ns_cmd brew && ns_cmd tor || { ui_error "Tor isn't installed. Run: ./install.sh --only darkweb"; return 1; }
    ui_question "Tor isn't running. Start it now (brew services start tor)?" || return 1
    brew services start tor >/dev/null 2>&1
  else
    ns_cmd tor || { ui_error "Tor isn't installed. Run: ./install.sh --only darkweb"; return 1; }
    ui_question "Tor isn't running. Start it now? (asks for your sudo password in the terminal)" || return 1
    sudo systemctl start tor
  fi
  echo "Waiting for Tor to connect…"
  local i=0
  while [ $i -lt 12 ]; do
    sleep 5
    ns_darkweb check >/dev/null 2>&1 && return 0
    i=$((i+1))
  done
  ui_error "Tor didn't connect within a minute. Check: systemctl status tor (Linux) or brew services list (macOS)."
  return 1
}

open_tor_browser() {
  if ui_mac; then
    open -a "Tor Browser" 2>/dev/null || ui_error "Tor Browser isn't installed. Run: ./install.sh --only browsers"
  elif [ -x "$NS_HOME/tor-browser/Browser/start-tor-browser" ]; then
    _ui_detach "$NS_HOME/tor-browser/Browser/start-tor-browser" --detach
  elif ns_cmd flatpak && flatpak info org.torproject.torbrowser-launcher >/dev/null 2>&1; then
    _ui_detach flatpak run org.torproject.torbrowser-launcher
  else
    ui_error "Tor Browser isn't installed. Run: ./install.sh --only browsers"
  fi
}

# OnionShare's command-line version, using the system tor (Linux)
onionshare_ready() {
  if ui_mac; then
    ui_error "On macOS, use the OnionShare app (Open the OnionShare app)."; return 1
  fi
  ns_cmd onionshare-cli || { ui_error "OnionShare isn't installed. Run: ./install.sh --only darkweb"; return 1; }
  ns_cmd tor || { ui_error "Tor isn't installed. Run: ./install.sh --only darkweb"; return 1; }
}

choice=$(ui_list "Dark web" \
  "Check Tor connection" \
  "Search onion services (Ahmia)" \
  "Fetch an onion page as text (safe)" \
  "Ransomware leak-site check (organisation)" \
  "Open Tor Browser" \
  "OnionShare: receive files from a source into this case" \
  "OnionShare: send files over a private .onion link" \
  "Open the OnionShare app") || exit 0

case "$choice" in
  Check*)
    if tor_ready; then r=$(ns_darkweb check 2>&1); else r="Tor is not available."; fi
    printf '%s\n' "$r"
    ui_info "$r" ;;

  Search*)
    # Ahmia's search form uses an anti-bot token, so northstar doesn't automate
    # it: the search opens in your browser with the query on the clipboard.
    q=$(ui_entry "Search terms:") || exit 0
    ns_audit ns-darkweb:ahmia "$q" "opened Ahmia (clearnet index of onion sites)"
    ui_clip "$q"
    ui_info "Click OK to open Ahmia, a search engine for onion sites. \"$q\" is on your clipboard: paste it into the search box.

Ahmia removes abuse material from its index. Open results in Tor Browser, or save one as text with \"Fetch an onion page as text\"."
    ui_open "https://ahmia.fi/"
    ui_notify "\"$q\" is on your clipboard: paste it into Ahmia" ;;

  Fetch*)
    u=$(ui_entry "Onion address or URL:") || exit 0
    tor_ready || exit 1
    host=$(printf '%s' "$u" | sed -E 's#^[a-z]+://##; s#/.*$##' | cut -c1-24)
    out=$(ns_outdir darkweb "$host")
    ns_run "$out" ns_darkweb fetch "$u"
    ns_finish "$out" ;;

  Ransomware*)
    q=$(ui_entry "Organisation name or domain:") || exit 0
    out=$(ns_outdir ransomware "$q")
    ns_run "$out" ns_darkweb ransomware "$q"
    ns_finish "$out" ;;

  "Open Tor Browser")
    open_tor_browser ;;

  # OnionShare runs in this terminal: its address and private key are shown here
  # only, never written to the case or the audit log
  "OnionShare: receive"*)
    onionshare_ready || exit 1
    ui_question "Receive files into case $(ns_case)

OnionShare starts a private .onion drop box. Give its address and private key to your source over a channel you trust; they open it in Tor Browser and upload files (or send text).

- Received files are UNTRUSTED: don't run programs or enable macros, and open documents only here in the VM.
- The address and key are shown in this terminal only, never saved to the case.
- Press Ctrl+C here to close the drop box. What arrived is then hashed and sealed in the case.

Start the drop box?" || exit 0
    title=$(ui_entry "Title the sender sees (optional, e.g. your organisation):") || title=""
    out=$(ns_outdir received onionshare)
    ns_audit ns-darkweb:onionshare "receive" "drop box opened (address and key not logged)"
    printf '\nOnionShare drop box: send the source the address AND the private key shown below.\nPress Ctrl+C to close it.\n\n'
    ( cd "$out" && onionshare-cli --receive --data-dir "$out/files" ${title:+--title "$title"} ) || true
    n=$(find "$out/files" -type f 2>/dev/null | wc -l | tr -d ' ')
    { echo "Received over OnionShare (receive mode) into case $(ns_case), closed $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      echo "Files: $n (untrusted: received from an outside source)"
      find "$out/files" -type f 2>/dev/null | sort | while IFS= read -r f; do
        printf '%s  %s\n' "$(ns_hash_file "$f")" "${f#"$out/"}"; done
    } > "$out/received.txt"
    ns_audit ns-darkweb:onionshare "receive" "drop box closed: $n file(s) received"
    if [ "$n" -gt 0 ] && ns_cmd ns_triage; then
      # Check what arrived before anyone opens it; the report is sealed with the files
      ns_triage --json "$out/triage.json" "$out/files" | tee "$out/triage.txt"
      ns_audit ns-darkweb:onionshare "triage" "$(sed -n 's/^File triage: //p' "$out/triage.txt" | head -1)"
    fi
    ns_finish "$out" ;;

  "OnionShare: send"*)
    onionshare_ready || exit 1
    files=$(ui_files "Choose what to send (for example a case export from $NS_DATA/Exports)") || exit 0
    set --
    while IFS= read -r f; do [ -f "$f" ] && set -- "$@" "$f"; done <<FILES
$files
FILES
    [ $# -gt 0 ] || exit 0
    ui_question "Send $# file(s) over OnionShare

- The recipient needs Tor Browser, the .onion address and the private key. Send the address and the key by two different channels you trust.
- Sharing stops after the first complete download, or when you press Ctrl+C here.
- The address and key are shown in this terminal only. The audit log records what was sent and its SHA-256, not how to reach it.

Start sharing?" || exit 0
    for f in "$@"; do ns_audit ns-darkweb:onionshare "$(basename "$f")" "sent over OnionShare: sha256 $(ns_hash_file "$f")"; done
    printf '\nOnionShare: give the recipient the address AND the private key shown below.\n\n'
    onionshare-cli "$@" || true ;;

  "Open the OnionShare app")
    if ui_mac && [ -d /Applications/OnionShare.app ]; then open -a OnionShare
    elif ns_cmd flatpak && flatpak info org.onionshare.OnionShare >/dev/null 2>&1; then
      ( setsid flatpak run org.onionshare.OnionShare >/dev/null 2>&1 & )
    else ui_error "OnionShare isn't installed. Run: ./install.sh --only darkweb"; fi ;;
esac
