{
  "code": "US",
  "name": "United States",
  "phone_region": "US",
  "searches": [
    {
      "label": "Person",
      "prompt": "Full name:",
      "links": [
        "https://www.courtlistener.com/?q={q}",
        "https://www.fec.gov/data/receipts/individual-contributions/?contributor_name={q}",
        "g:\"{q}\" site:linkedin.com/in",
        "g:\"{q}\" (site:legacy.com OR site:tributearchive.com) obituary",
        "g:\"{q}\" (site:apnews.com OR site:reuters.com OR site:nytimes.com OR site:washingtonpost.com)",
        "https://www.bop.gov/inmateloc/",
        "https://www.nsopw.gov/"
      ]
    },
    {
      "label": "Missing persons",
      "prompt": "Name of the missing or unidentified person:",
      "links": [
        "https://charleyproject.org/?s={q}",
        "g:\"{q}\" (site:namus.nij.ojp.gov OR site:missingkids.org OR site:doenetwork.org)",
        "g:\"{q}\" site:fbi.gov missing OR kidnapping",
        "https://namus.nij.ojp.gov/",
        "https://www.missingkids.org/gethelpnow/search"
      ],
      "note": "NamUs and NCMEC searches can't be pre-filled: the name is on the clipboard."
    },
    {
      "label": "Business / organization",
      "prompt": "Business or organization name:",
      "links": [
        "https://opencorporates.com/companies?q={q}",
        "https://www.sec.gov/cgi-bin/browse-edgar?company={q}&owner=exclude&action=getcompany",
        "https://projects.propublica.org/nonprofits/search?q={q}",
        "https://apps.irs.gov/app/eos/",
        "https://sam.gov/",
        "https://www.usaspending.gov/search",
        "https://tmsearch.uspto.gov/",
        "g:\"{q}\" (lawsuit OR fraud OR complaint OR settlement)"
      ],
      "note": "State business registries: use OpenCorporates, or the Secretary of State site for the state."
    },
    {
      "label": "Phone number",
      "prompt": "Phone number (any format):",
      "type": "phone",
      "links": [
        "g:\"{alt}\" OR \"{national}\" OR \"{intl}\" OR \"{e164}\"",
        "g:\"{alt}\" OR \"{national}\" OR \"{e164}\" (scam OR fraud OR spam)",
        "g:\"{alt}\" OR \"{national}\" OR \"{intl}\" (site:facebook.com OR site:linkedin.com OR site:craigslist.org OR site:instagram.com)"
      ]
    },
    {
      "label": "Address / property",
      "prompt": "Address or postcode:",
      "links": [
        "https://www.google.com/maps/search/?api=1&query={q}",
        "https://www.openstreetmap.org/search?query={q}",
        "g:\"{q}\"",
        "https://publicrecords.netronline.com/"
      ]
    },
    {
      "label": "Courts & legal",
      "prompt": "Name, company or case:",
      "links": [
        "https://www.courtlistener.com/?q={q}",
        "https://pacer.uscourts.gov/",
        "g:\"{q}\" site:justia.com",
        "g:\"{q}\" site:casetext.com OR site:law.cornell.edu"
      ],
      "note": "PACER needs an account and charges per page; CourtListener's RECAP archive is free."
    },
    {
      "label": "Financial & regulatory check",
      "prompt": "Person or firm name:",
      "links": [
        "https://brokercheck.finra.org/",
        "https://adviserinfo.sec.gov/",
        "https://sanctionssearch.ofac.treas.gov/",
        "https://www.fincen.gov/msb-registrant-search",
        "https://www.consumerfinance.gov/data-research/consumer-complaints/search/?searchText={q}",
        "g:\"{q}\" site:sec.gov/litigation"
      ]
    },
    {
      "label": "Political contributions & lobbying",
      "prompt": "Person or organization name:",
      "links": [
        "https://www.fec.gov/data/receipts/individual-contributions/?contributor_name={q}",
        "https://www.opensecrets.org/search?q={q}",
        "https://lda.senate.gov/filings/public/filing/search/",
        "https://efile.fara.gov/ords/fara/f?p=1235:10"
      ]
    },
    {
      "label": "Vessel",
      "prompt": "Vessel name or official number:",
      "links": [
        "https://cgmix.uscg.mil/PSIX/PSIXSearch.aspx",
        "g:\"{q}\" vessel"
      ]
    },
    {
      "label": "Aircraft (N-number)",
      "prompt": "N-number (e.g. N12345):",
      "transform": [
        "alnum",
        "upper"
      ],
      "links": [
        "https://registry.faa.gov/AircraftInquiry/Search/NNumberResult?nNumberTxt={q}",
        "https://www.flightradar24.com/data/aircraft/{q}",
        "g:\"{q}\" aircraft"
      ]
    },
    {
      "label": "Vehicle (VIN)",
      "prompt": "17-character VIN:",
      "transform": [
        "alnum",
        "upper"
      ],
      "links": [
        "https://vpic.nhtsa.dot.gov/decoder/Decoder?VIN={q}",
        "https://www.nicb.org/vincheck",
        "https://www.nhtsa.gov/recalls",
        "g:\"{q}\""
      ]
    },
    {
      "label": "Amateur radio call sign",
      "prompt": "Call sign:",
      "transform": [
        "callsign",
        "upper"
      ],
      "links": [
        "https://www.qrz.com/db/{q}",
        "https://wireless2.fcc.gov/UlsApp/UlsSearch/searchLicense.jsp",
        "g:\"{q}\""
      ]
    }
  ],
