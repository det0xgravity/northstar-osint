{
  "code": "ES",
  "name": "Spain",
  "phone_region": "ES",
  "searches": [
    {
      "label": "Person",
      "prompt": "Full name:",
      "links": [
        "g:\"{q}\" site:poderjudicial.es",
        "https://www.publicidadconcursal.es/",
        "g:\"{q}\" site:boe.es",
        "g:\"{q}\" (esquela OR fallecimiento OR \"ha fallecido\")",
        "g:\"{q}\" site:es.linkedin.com",
        "g:\"{q}\" (site:elpais.com OR site:elmundo.es OR site:abc.es OR site:lavanguardia.com OR site:rtve.es)"
      ]
    },
    {
      "label": "Business / organization",
      "prompt": "Company name:",
      "links": [
        "https://www.registradores.org/",
        "https://www.boe.es/diario_borme/",
        "g:\"{q}\" site:boe.es borme",
        "https://opencorporates.com/companies/es?q={q}",
        "https://contrataciondelestado.es/",
        "https://www.oepm.es/",
        "g:\"{q}\" (estafa OR fraude OR concurso OR denuncia)"
      ]
    },
    {
      "label": "Phone number",
      "prompt": "Phone number (any format):",
      "type": "phone",
      "links": [
        "g:\"{alt}\" OR \"{national}\" OR \"{intl}\" OR \"{e164}\"",
        "g:\"{alt}\" OR \"{national}\" OR \"{e164}\" (scam OR fraud OR spam)",
        "g:\"{alt}\" OR \"{national}\" OR \"{intl}\" (site:facebook.com OR site:linkedin.com OR site:milanuncios.com OR site:listaspam.com)"
      ]
    },
    {
      "label": "Address / property",
      "prompt": "Address or postcode:",
      "links": [
        "https://www.google.com/maps/search/?api=1&query={q}",
        "https://www.openstreetmap.org/search?query={q}",
        "g:\"{q}\"",
        "https://www.sedecatastro.gob.es/"
      ]
    },
    {
      "label": "Courts & legal",
      "prompt": "Name, company or case:",
      "links": [
        "https://www.poderjudicial.es/search/indexAN.jsp",
        "https://www.publicidadconcursal.es/",
        "g:\"{q}\" site:poderjudicial.es"
      ]
    },
    {
      "label": "Financial & regulatory check",
      "prompt": "Person or firm name:",
