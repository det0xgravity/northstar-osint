        "https://www.bde.es/"
      ]
    },
    {
      "label": "Political & lobbying",
      "prompt": "Person or organization name:",
      "links": [
        "g:\"{q}\" site:congreso.es",
        "g:\"{q}\" site:transparencia.gob.es"
      ]
    },
    {
      "label": "Aircraft",
      "prompt": "Registration (e.g. EC-ABC):",
      "transform": [
        "upper"
      ],
      "links": [
        "https://www.flightradar24.com/data/aircraft/{q}",
