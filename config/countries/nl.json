        },
        {
          "name": "Officiële Bekendmakingen",
          "url": "https://www.officielebekendmakingen.nl/"
        },
        {
          "name": "TenderNed",
          "url": "https://www.tenderned.nl/"
        }
      ]
    },
    {
      "name": "Rechtspraak",
      "children": [
        {
          "name": "Uitspraken (court decisions)",
          "url": "https://uitspraken.rechtspraak.nl/"
        },
        {
          "name": "Insolventieregister",
          "url": "https://insolventies.rechtspraak.nl/"
        }
      ]
    },
    {
      "name": "Vastgoed & Voertuigen",
      "children": [
        {
