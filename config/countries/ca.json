{
  "code": "CA",
  "name": "Canada",
  "phone_region": "CA",
  "searches": [
    {
      "label": "Person",
      "prompt": "Full name:",
      "links": [
        "g:\"{q}\" site:canlii.org",
        "g:\"{q}\" (site:legacy.com OR site:inmemoriam.ca OR site:dignitymemorial.com) Canada",
        "g:\"{q}\" site:ca.linkedin.com",
        "g:\"{q}\" (site:cbc.ca OR site:ctvnews.ca OR site:globalnews.ca OR site:thestar.com OR site:theglobeandmail.com)",
        "g:\"{q}\" site:gazette.gc.ca",
        "g:\"{q}\" (site:ontario.ca OR site:canada.ca OR site:gc.ca)",
        "https://www.canada411.ca/",
        "https://geds-sage.gc.ca/"
      ]
    },
    {
      "label": "Business / organization",
      "prompt": "Business or organization name:",
      "links": [
        "https://opencorporates.com/companies?q={q}",
        "https://ised-isde.canada.ca/cc/lgcy/fdrlCrpSrch.html",
        "https://www.ontario.ca/page/ontario-business-registry",
        "https://www.sedarplus.ca/",
        "https://apps.cra-arc.gc.ca/ebci/hacc/srch/pub/dsplyAdvncdSrch",
        "https://fintrac-canafe.canada.ca/msb-esm/reg-eng",
        "g:\"{q}\" site:canlii.org",
        "g:\"{q}\" (scam OR fraud OR complaint OR lawsuit) Canada"
      ]
    },
    {
      "label": "Phone number",
      "type": "phone",
      "prompt": "Phone number (any format):",
      "links": [
        "g:\"{alt}\" OR \"{national}\" OR \"{intl}\" OR \"{digits}\"",
        "g:\"{alt}\" OR \"{digits}\" (scam OR fraud OR spam)",
        "g:\"{alt}\" OR \"{national}\" (site:facebook.com OR site:kijiji.ca OR site:linkedin.com)",
        "https://www.canada411.ca/",
        "https://www.cnac.ca/"
      ],
      "note": "Canada411's reverse lookup can't be pre-filled: paste the number from your clipboard."
    },
    {
      "label": "Address / postal code",
      "prompt": "Address or postal code:",
      "links": [
        "https://www.google.com/maps/search/?api=1&query={q}",
        "https://www.openstreetmap.org/search?query={q}",
        "g:\"{q}\"",
        "https://www.onland.ca/",
        "https://www.aboutmyproperty.ca/",
        "https://www.canadapost-postescanada.ca/info/mc/personal/postalcode/fpc.jsf"
      ]
    },
    {
      "label": "Financial & regulatory check",
      "prompt": "Person or firm name:",
      "links": [
        "https://www.aretheyregistered.ca/",
        "https://fintrac-canafe.canada.ca/msb-esm/reg-eng",
        "https://fintrac-canafe.canada.ca/msb-esm/revoked-revoquee-eng",
        "https://www.ic.gc.ca/app/scr/bsf-osb/ins/login.html?lang=eng",
        "https://www.international.gc.ca/world-monde/international_relations-relations_internationales/sanctions/consolidated-consolide.aspx?lang=eng",
        "g:\"{q}\" (site:osc.ca OR site:bcsc.bc.ca OR site:securities-administrators.ca OR site:albertasecurities.com OR site:lautorite.qc.ca)",
        "g:\"{q}\" site:canlii.org"
      ]
    },
    {
      "label": "Political contributions & lobbying",
      "prompt": "Person or organization name:",
      "links": [
        "https://www.elections.ca/WPAPPS/WPF/EN/CCS/Index",
        "https://www.elections.on.ca/en/political-financing0.html",
        "https://contributions.electionsbc.gov.bc.ca/pcs/SA1ASearch.aspx",
        "https://lobbycanada.gc.ca/",
        "g:\"{q}\" site:lobbycanada.gc.ca"
      ]
    },
    {
      "label": "Vessel",
      "prompt": "Vessel name or official number:",
      "links": [
        "https://eve.tc.canada.ca/en/VR-IB/search",
        "https://recherche-collection-search.bac-lac.gc.ca/eng/home/searchadvanced?SubsetCode=253&DataSource=Archives%7CFonAndCol",
        "g:\"{q}\" vessel Canada"
      ]
    },
    {
      "label": "Aircraft",
      "prompt": "Registration (e.g. C-GABC):",
      "transform": [
        "upper"
      ],
      "links": [
        "https://wwwapps.tc.gc.ca/saf-sec-sur/2/ccarcs-riacc/RchSimp.aspx",
        "g:\"{q}\" aircraft"
      ]
    },
    {
      "label": "Vehicle (VIN)",
      "prompt": "17-character VIN:",
      "transform": [
        "alnum",
        "upper"
      ],
      "links": [
        "https://vpic.nhtsa.dot.gov/decoder/Decoder?VIN={q}",
        "g:\"{q}\""
      ]
    },
    {
      "label": "Amateur radio call sign",
      "prompt": "Call sign:",
      "transform": [
        "callsign",
        "upper"
      ],
      "links": [
        "https://www.qrz.com/db/{q}",
        "https://ised-isde.canada.ca/site/amateur-radio-operator-certificate-services/en",
        "g:\"{q}\""
      ]
    }
  ],
