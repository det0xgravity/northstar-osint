{
  "code": "GB",
  "name": "United Kingdom",
  "phone_region": "GB",
  "searches": [
    {
      "label": "Person",
      "prompt": "Full name:",
      "links": [
        "https://find-and-update.company-information.service.gov.uk/search/officers?q={q}",
        "https://find-and-update.company-information.service.gov.uk/search/disqualified-officers?q={q}",
        "https://www.thegazette.co.uk/all-notices/notice?text={q}",
        "https://caselaw.nationalarchives.gov.uk/search?query={q}",
        "g:\"{q}\" site:uk.linkedin.com",
        "g:\"{q}\" (site:funeral-notices.co.uk OR site:legacy.com) UK",
        "g:\"{q}\" (site:bbc.co.uk OR site:theguardian.com OR site:thetimes.co.uk)",
        "https://www.insolvencydirect.bis.gov.uk/eiir/",
        "https://probatesearch.service.gov.uk/"
      ]
    },
    {
      "label": "Missing persons",
      "prompt": "Name of the missing or unidentified person:",
      "links": [
        "g:\"{q}\" (site:missingpeople.org.uk OR site:missingpersons.police.uk)",
        "https://www.missingpeople.org.uk/appeal-search",
        "https://missingpersons.police.uk/"
      ],
      "note": "Missing People's charity helpline is 116 000; the UK Missing Persons Unit also holds unidentified-person cases."
    },
    {
      "label": "Business / organization",
      "prompt": "Company or organization name:",
      "links": [
        "https://find-and-update.company-information.service.gov.uk/search/companies?q={q}",
        "https://opencorporates.com/companies/gb?q={q}",
        "https://register-of-charities.charitycommission.gov.uk/en/charity-search",
        "https://register.fca.org.uk/s/",
        "https://www.find-tender.service.gov.uk/Search",
        "https://www.contractsfinder.service.gov.uk/Search",
        "https://trademarks.ipo.gov.uk/ipo-tmtext",
        "g:\"{q}\" (scam OR fraud OR complaint OR tribunal) UK"
      ]
    },
    {
      "label": "Phone number",
      "prompt": "Phone number (any format):",
      "type": "phone",
      "links": [
        "g:\"{alt}\" OR \"{national}\" OR \"{intl}\" OR \"{e164}\"",
        "g:\"{alt}\" OR \"{national}\" OR \"{e164}\" (scam OR fraud OR spam)",
        "g:\"{alt}\" OR \"{national}\" OR \"{intl}\" (site:facebook.com OR site:linkedin.com OR site:who-called.co.uk OR site:tellows.co.uk)"
      ]
    },
    {
      "label": "Address / property",
      "prompt": "Address or postcode:",
      "links": [
        "https://www.google.com/maps/search/?api=1&query={q}",
        "https://www.openstreetmap.org/search?query={q}",
        "g:\"{q}\"",
        "https://search-property-information.service.gov.uk/",
        "https://find-energy-certificate.service.gov.uk/",
        "https://landregistry.data.gov.uk/app/ppd",
        "https://www.police.uk/"
      ]
    },
    {
      "label": "Courts & legal",
      "prompt": "Name, company or case:",
      "links": [
        "https://caselaw.nationalarchives.gov.uk/search?query={q}",
        "https://www.bailii.org/",
        "https://www.thegazette.co.uk/all-notices/notice?text={q}"
      ]
    },
    {
      "label": "Financial & regulatory check",
      "prompt": "Person or firm name:",
      "links": [
        "https://register.fca.org.uk/s/",
        "https://www.fca.org.uk/scamsmart/warning-list",
        "https://find-and-update.company-information.service.gov.uk/search/disqualified-officers?q={q}",
        "https://www.insolvencydirect.bis.gov.uk/eiir/",
        "https://www.gov.uk/government/publications/the-uk-sanctions-list",
        "g:\"{q}\" site:fca.org.uk"
      ]
    },
    {
      "label": "Political donations & interests",
      "prompt": "Person or organization name:",
      "links": [
        "https://search.electoralcommission.org.uk/",
        "g:\"{q}\" site:parliament.uk (interests OR register)",
        "https://registrarofconsultantlobbyists.org.uk/"
      ]
    },
    {
      "label": "Vehicle (registration)",
      "prompt": "Registration number:",
      "transform": [
        "alnum",
        "upper"
      ],
      "links": [
        "https://vehicleenquiry.service.gov.uk/",
        "https://www.check-mot.service.gov.uk/",
        "g:\"{q}\""
      ],
      "note": "DVLA and MOT checks can't be pre-filled: paste the registration from your clipboard."
    },
    {
      "label": "Aircraft",
      "prompt": "Registration (e.g. G-ABCD):",
      "transform": [
        "upper"
      ],
      "links": [
        "https://www.caa.co.uk/aircraft-register/g-info/",
        "https://www.flightradar24.com/data/aircraft/{q}",
        "g:\"{q}\" aircraft"
      ]
    }
  ],
